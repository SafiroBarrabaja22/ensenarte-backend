# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Origenes del frontend autorizados para consumir la API (CORS), separados por
# coma. Solo esquema + dominio (+ puerto): sin ruta y sin barra final.
# Prohibido "*": el backend se niega a arrancar. Ver docs/SEGURIDAD.md.
#
# Desarrollo local (Live Server / python -m http.server en el puerto 5500):
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Produccion (frontend en GitHub Pages). OJO: el origen NO lleva la ruta
# /ensenarte-frontend/ aunque la pagina se vea en esa ruta:
# CORS_ALLOWED_ORIGINS=https://safirobarrabaja22.github.io

# Base de datos. Con sqlite basta dejar la linea de abajo.
DATABASE_URL=sqlite:///db.sqlite3
# Para PostgreSQL:
# DATABASE_URL=postgres://usuario:clave@localhost:5432/ensenarte

# JWT (opcionales; estos son los valores por defecto)
# JWT_ACCESO_MINUTOS=15
# JWT_REFRESCO_DIAS=7

# Correo (apps/correos). Con DEBUG=True los correos se imprimen en la consola y
# no se envia nada real; con DEBUG=False se usa SMTP con estos datos.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend   # forzar SMTP aun con DEBUG=True
EMAIL_HOST=smtp.ejemplo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=enSEÑArte <no-responder@ejemplo.com>
# URL publica del frontend para los enlaces de los correos (con la ruta del sitio):
URL_FRONTEND=http://127.0.0.1:5500
# URL_FRONTEND=https://safirobarrabaja22.github.io/ensenarte-frontend

# Evaluacion con camara
EVALUACION_CAMARA_MAX_INTENTOS=50
EVALUACION_CAMARA_UMBRAL_APROBACION=70
