# Variables del backend en Docker. Copialo a la carpeta del docker-compose.yml
# como ".env" (cp ensenarte-backend/despliegue/docker.env.example .env), pon
# los valores reales y dale permisos 600. NUNCA lo subas a git.
#
# Formato de env_file de Docker Compose: VARIABLE=valor, sin comillas y sin
# comentarios al final de la linea. Lo que va entre <...> lo pones tu.

# --- Django -------------------------------------------------------------------
# Genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<clave_larga_aleatoria>
DEBUG=False
# Dominio de Tailscale Funnel + localhost (lo usa el healthcheck del contenedor).
ALLOWED_HOSTS=cachyos-x8664.tailb93c3e.ts.net,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://cachyos-x8664.tailb93c3e.ts.net
# Frontend y API comparten dominio (proxy de nginx): CORS no se usa, pero la
# variable no puede quedar vacia.
CORS_ALLOWED_ORIGINS=https://cachyos-x8664.tailb93c3e.ts.net
# Enlaces de los correos (recuperacion de contrasena, bienvenida).
URL_FRONTEND=https://cachyos-x8664.tailb93c3e.ts.net
# Proxies delante de Django: Tailscale Funnel y el nginx del frontend. Asi el
# limite de intentos de login usa la IP real de cada visitante.
NUM_PROXIES=2

# --- Base de datos: el MySQL/MariaDB instalado en la miniPC ------------------
DB_NAME=proyecto_v2
DB_USER=<usuario_bd>
DB_PASSWORD=<clave_bd>
DB_HOST=host.docker.internal
DB_PORT=3306

# --- Correo (Gmail, contrasena de aplicacion; ver docs/DESPLIEGUE.md 1.5.1) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=<cuenta>@gmail.com
EMAIL_HOST_PASSWORD=<contrasena_de_aplicacion>
DEFAULT_FROM_EMAIL=enSEÑArte <<cuenta>@gmail.com>

# --- Opcionales (estos son los valores por defecto) ---------------------------
# Procesos de gunicorn.
WEB_CONCURRENCY=3
NIVEL_LOG=WARNING
# JWT_ACCESO_MINUTOS=15
# JWT_REFRESCO_DIAS=7
# LOGIN_MAX_FALLOS=5
# LOGIN_BLOQUEO_MINUTOS=15
# PASSWORD_RESET_TIMEOUT=3600
# RECUPERAR_MAX_POR_CORREO=10
# EVALUACION_CAMARA_MAX_INTENTOS=50
# EVALUACION_CAMARA_UMBRAL_APROBACION=70
